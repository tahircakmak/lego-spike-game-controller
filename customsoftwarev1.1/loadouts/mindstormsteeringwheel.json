{
  "name": "mindstormsteeringwheel",
  "description": "MINDSTORMS Robot Inventor steering wheel rig: the wheel's motor (port B) steers with the left stick, the lever's motor (port D) is the pedals: push it forward to accelerate (RT), pull it back to brake (LT). Left hub button: handbrake (A). Right hub button: pause (Menu). If the motors are on other ports, change the source of each binding. If steering or the lever works the wrong way round, tick Invert direction for that motor on Devices & calibration. For the best feel, tick Return to rest for both motors there too.",
  "settings": {
    "min_press_ms": 100
  },
  "variables": [],
  "systems": [
    {
      "id": "driving",
      "name": "Driving",
      "enabled": true,
      "conditions": []
    }
  ],
  "bindings": [
    {
      "id": "steer",
      "name": "Steering wheel (B): left stick left / right",
      "system": "driving",
      "kind": "axis",
      "enabled": true,
      "conditions": [],
      "source": "motor:B",
      "output": "ls:x",
      "deadzone": [
        -3,
        3
      ],
      "range": null,
      "invert": false
    },
    {
      "id": "throttle",
      "name": "Lever (D) forward: accelerate (RT)",
      "system": "driving",
      "kind": "axis",
      "enabled": true,
      "conditions": [],
      "source": "motor:D",
      "output": "rt",
      "deadzone": [
        -4,
        4
      ],
      "range": null,
      "invert": false
    },
    {
      "id": "brake",
